<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Tunnel.json;appsettings.Tunnel.json.*" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CosmeticsShop.Application\CosmeticsShop.Application.csproj" />
    <ProjectReference Include="..\CosmeticsShop.Contracts\CosmeticsShop.Contracts.csproj" />
    <ProjectReference Include="..\CosmeticsShop.Infrastructure\CosmeticsShop.Infrastructure.csproj" />
  </ItemGroup>

</Project>
