# Copy to .env and replace the password before starting PostgreSQL.
POSTGRES_PASSWORD=replace-with-local-password
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=
# Optional proxy for Bot API requests only, e.g. socks5://host.docker.internal:1080 (see docs/telegram-proxy.md).
TELEGRAM_PROXY_URL=
# Exact IP of the TLS proxy as seen by the app; leave empty for local public catalog only.
TRUSTED_PROXY_IP=
