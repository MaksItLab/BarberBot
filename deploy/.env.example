# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Domain whose A record points to this server, without https://
DOMAIN=shop.example.ru
# Let's Encrypt contact for certificate expiry notices.
ACME_EMAIL=owner@example.ru
# Long random password: openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-strong-password
# Enable only after the bot is stopped everywhere else (long polling allows one instance).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
